# Least-privilege login belonging to duecare_runtime. Pooler URL with SSL in production.
DATABASE_URL=postgresql+psycopg://duecare_app:CHANGE_ME@localhost:5432/postgres
# Privileged direct/session-pooler connection; never used by runtime.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
WEB_ORIGIN=http://localhost:3000
# Match apps/web/.env.local; generate with secrets.token_urlsafe(48).
GATEWAY_SECRET=GENERATE_A_RANDOM_SECRET
# Fernet key, generate with cryptography.fernet.Fernet.generate_key().
SESSION_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
