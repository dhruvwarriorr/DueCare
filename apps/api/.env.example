# Least-privilege login belonging to duecare_runtime. Pooler URL with SSL in production.
DATABASE_URL=postgresql+psycopg://duecare_app:CHANGE_ME@localhost:5432/postgres
# Privileged direct/session-pooler connection; never used by runtime.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
WEB_ORIGIN=http://localhost:3000
# Mobile app sign-in return address (its deep link). Add it to Supabase's Auth redirect allowlist.
# Leave empty to turn mobile sign-in off.
MOBILE_REDIRECT_URL=duecare://auth/callback
# Local servers use embedded. Vercel uses external and a Supabase scheduled dispatcher.
BACKGROUND_WORKER_MODE=embedded
WORKER_DISPATCH_SECRET=
# Match apps/web/.env.local; generate with secrets.token_urlsafe(48).
GATEWAY_SECRET=GENERATE_A_RANDOM_SECRET
# Fernet key, generate with cryptography.fernet.Fernet.generate_key().
SESSION_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
# Phase 2 source authorization (separate from Supabase login). Web application OAuth client
# whose authorized redirect URI is WEB_ORIGIN + /connections/callback.
GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
# Versioned Fernet keys for source refresh/access tokens: "v1:key,v2:key". New tokens use the
# current version; older versions stay listed until every stored token has been re-encrypted.
SOURCE_TOKEN_KEYS=v1:GENERATE_A_FERNET_KEY
SOURCE_TOKEN_KEY_VERSION=v1
# Work budget per sync advance request (seconds); the gateway allows extra response overhead.
SYNC_WORK_BUDGET_SECONDS=90
GOOGLE_REQUEST_TIMEOUT_SECONDS=15
# Sender domains eligible for the academic prefilter (exact domain or its subdomains).
ACADEMIC_SENDER_DOMAINS=somaiya.edu
# Phase 3 interpretation. OpenRouter is primary when its key and model are set; otherwise Groq.
# Create an OpenRouter key at https://openrouter.ai/settings/keys and set a JSON-mode model ID.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
# Maximum simultaneous OpenRouter calls shared by Gmail and Classroom (1 to 10).
OPENROUTER_CONCURRENCY=10
OPENROUTER_MAX_OUTPUT_TOKENS=8192
OPENROUTER_REASONING_EFFORT=low
# Groq is the next provider (OpenAI-compatible API, JSON mode).
# Set exact model IDs from https://console.groq.com/docs/models; GROQ_FALLBACK_MODEL is tried when the
# Groq model fails or returns invalid output twice. OpenAI/Gemini are optional further fallbacks.
# Without any key, LMS template mail and Classroom submission states are still processed; other
# items pause and resume after configuration.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_SECONDS=45
# The Somaiya LMS sender and host are always recognized (same for every student); list extras here.
LMS_SENDERS=lms-kjsse@somaiya.edu
LMS_HOSTS=lms-kjsce.somaiya.edu
# Verified LMS assignment/quiz receipts and own Classroom TURNED_IN states complete automatically.
# Optional additional completion paths (built-in paths do not need configuration).
AUTO_COMPLETION_PATHS=
