      "css": ".ds-nav{display:flex;height:64px;border-bottom:1px solid var(--graphite,#18171b);background:var(--sheet,#fff)}.ds-nav-i{position:relative;display:inline-flex;align-items:center;padding:0 16px;font-size:15px;font-weight:500;color:var(--graphite,#18171b);text-decoration:none}.ds-nav-i::after{content:\"\";position:absolute;left:16px;right:16px;bottom:-1px;height:4px;background:transparent;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1)}.ds-nav-i:hover:not(.ds-on)::after{background:var(--ink-rule,#efc3d2)}.ds-nav-i.ds-on{font-weight:700}.ds-nav-i.ds-on::after{background:var(--graphite,#18171b)}.ds-nav-i:focus-visible{outline:2px solid var(--graphite,#18171b);outline-offset:-2px}"
