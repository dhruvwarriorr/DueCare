      "css": ".ds-field{display:grid;gap:6px;width:280px}.ds-field span{font-family:var(--font-condensed),\"Sofia Sans Condensed\",\"Arial Narrow\",sans-serif;font-weight:700;font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink,#c21c58)}.ds-field input{min-height:44px;padding:10px 12px;border:1px solid var(--ink-line,#d4668b);border-radius:0;background:var(--sheet,#fff);color:var(--graphite,#18171b);font:inherit;caret-color:var(--ink,#c21c58)}.ds-field input:hover{border-color:var(--ink,#c21c58)}.ds-field input:focus{outline:2px solid var(--graphite,#18171b);outline-offset:0;border-color:var(--graphite,#18171b)}"
