      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border:1px solid transparent;border-radius:0;font-family:var(--font-body),\"Sofia Sans\",system-ui,sans-serif;font-weight:600;font-size:14px;line-height:1;cursor:pointer;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1),color 160ms,border-color 160ms}.ds-btn:focus-visible{outline:2px solid var(--graphite,#18171b);outline-offset:2px}.ds-btn-primary{background:var(--graphite,#18171b);border-color:var(--graphite,#18171b);color:var(--on-graphite,#fff)}.ds-btn-primary:hover{background:var(--ink,#c21c58);border-color:var(--ink,#c21c58);color:var(--on-ink,#fff)}"
