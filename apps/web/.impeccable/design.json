    {
      "name": "Status Pill",
      "kind": "chip",
      "refersTo": "status-due",
      "description": "Square caps pill coloured by state: yellow due, green done, red overdue, red tint struck missed.",
      "html": "<span class=\"ds-st\">Due</span> <span class=\"ds-st ds-st-done\">Done</span> <span class=\"ds-st ds-st-over\">Overdue</span> <span class=\"ds-st ds-st-miss\">Missed</span>",
      "css": ".ds-st{display:inline-flex;align-items:center;height:26px;padding:0 10px;border:1px solid var(--due-line,#d9ad00);background:var(--due,#f5c400);color:var(--on-due,#2b2100);font-family:var(--font-condensed),\"Sofia Sans Condensed\",\"Arial Narrow\",sans-serif;font-weight:700;font-size:12px;letter-spacing:.07em;text-transform:uppercase}.ds-st-done{background:var(--good,#1d7440);border-color:var(--good,#1d7440);color:var(--on-good,#fff)}.ds-st-over{background:var(--bad,#c8261e);border-color:var(--bad,#c8261e);color:var(--on-bad,#fff)}.ds-st-miss{background:var(--bad-tint,#fde8e5);border-color:var(--bad,#c8261e);color:var(--bad-text,#b4231b);text-decoration:line-through}"
