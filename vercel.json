{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_URL" }
      ]
    },
    "api": {
      "root": "apps/api",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/ready", "destination": { "service": "api" } },
    { "source": "/internal/jobs/advance", "destination": { "service": "api" } },
    { "source": "/api/v1/mobile/(.*)", "destination": { "service": "api" } },
    {
      "source": "/api/v1/(.*)",
      "has": [{ "type": "header", "key": "authorization", "value": "Bearer .+" }],
      "destination": { "service": "api" }
    },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
